{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "previewId", "channel", "source", "build", "artifacts", "routeKey", "createdAt", "expiresAt", "teardownAfter"],
  "properties": {
    "schemaVersion": {"const": 1}, "previewId": {"type": "string"}, "channel": {"enum": ["feature", "nightly", "promotion"]},
    "source": {"type": "object"}, "build": {"type": "object"}, "artifacts": {"type": "array", "minItems": 1}, "routeKey": {"type": "string", "pattern": "^(nightly|feature-[a-z0-9-]+)$"},
    "createdAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}, "teardownAfter": {"type": "string", "format": "date-time"}
  }
}
