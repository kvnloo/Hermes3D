{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "captainGate", "base", "nightlyAttestation", "features", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mode": {"enum": ["individual", "all"]},
    "captainGate": {"const": "G1_G2_REQUIRED"},
    "base": {"type": "object", "additionalProperties": false, "required": ["branch", "sha"], "properties": {"branch": {"const": "dev"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "nightlyAttestation": {"type": "object", "additionalProperties": false, "required": ["manifestDigest", "treeSha", "receiptDigest"], "properties": {"manifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "treeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "receiptDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "features": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["slug", "headSha", "order"], "properties": {"slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "order": {"type": "integer", "minimum": 0}}}},
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}
